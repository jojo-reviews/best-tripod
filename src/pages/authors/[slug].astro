---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import { getPublishedPosts } from '../../lib/posts';
import { SITE, absUrl, authorSchema, initials } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return SITE.authors.map((a) => ({ params: { slug: a.slug }, props: { author: a, posts: posts.filter((p) => p.data.author === a.slug), reviewed: posts.filter((p) => p.data.reviewedBy === a.slug) } }));
}
const { author, posts, reviewed } = Astro.props;
const LABELS: Record<string, string> = { 'flickr.com': 'Flickr', 'instagram.com': 'Instagram', 'linkedin.com': 'LinkedIn', 'uglyhedgehog.com': 'Ugly Hedgehog', 'realphotographersforum.com': 'Real Photographers Forum' };
const siteLabel = (u: string) => { const h = new URL(u).hostname.replace('www.', ''); return LABELS[h] ?? h; };
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: absUrl(`/authors/${author.slug}/`),
  mainEntity: authorSchema(author),
}];
---
<Base title={`${author.name} – ${author.role}`} description={author.bio.slice(0, 158)} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="page-head">
      <div style="display:flex;gap:18px;align-items:center;margin-bottom:12px">
        <span class="avatar" style="width:72px;height:72px;font-size:1.2rem">{(author.image || author.type !== 'Person') ? <img src={author.image ?? '/favicon.svg'} alt={author.name} width="72" height="72" /> : initials(author.name)}</span>
        <div><h1 style="margin:0;font-size:var(--s4)">{author.name}</h1><p class="muted" style="margin:4px 0 0">{author.role}</p></div>
      </div>
      <p class="dek">{author.bio}</p>
      {(author as any).photo && <figure class="author-photo" style="margin:18px 0;max-width:420px"><img src={(author as any).photo.src} alt={(author as any).photo.alt} width={(author as any).photo.width} height={(author as any).photo.height} loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:12px" /></figure>}
      {author.expertise.length > 0 && <p><strong>{author.type === 'Person' ? 'Focus areas' : 'Covers'}:</strong> {author.expertise.join(', ')}.</p>}
      {((author as any).gear ?? []).length > 0 && <p><strong>Gear:</strong> {(author as any).gear.join(', ')}.</p>}
      {author.sameAs.length > 0 && <p>{author.type === 'Person' ? 'Follow: ' : 'Find us on: '}{author.sameAs.map((u, i) => <>{i > 0 && ', '}<a href={u} rel="me noopener" target="_blank">{siteLabel(u)}</a></>)}</p>}
      {(author as any).email && <p>Email: <a href={`mailto:${(author as any).email}`}>{(author as any).email}</a></p>}
      <p>Every guide follows our <a href="/how-we-research/">research process</a> and <a href="/editorial-policy/">editorial policy</a>.</p>
    </header>
    <section class="section">
      <div class="section-head"><h2>Guides by {author.name} ({posts.length})</h2></div>
      {posts.length ? <div class="posts">{posts.map((p) => <PostItem post={p} />)}</div> : <p class="empty">No guides yet.</p>}
    </section>
    {reviewed.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Guides reviewed by {author.name}</h2></div>
        <div class="posts">{reviewed.map((p) => <PostItem post={p} />)}</div>
      </section>
    )}
  </div>
</Base>
