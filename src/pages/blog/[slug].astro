---
import { unsplashCredit } from '../../lib/remark-photos.mjs';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductPicks from '../../components/ProductPicks.astro';
import PostItem from '../../components/PostItem.astro';
import { getPublishedPosts } from '../../lib/posts';
import { SITE, categoryName, formatDate, absUrl, getAuthor, authorSchema, initials } from '../../lib/site';
import { amazonUrl, AFFILIATE_REL } from '../../lib/affiliate.mjs';
import { imageCredit } from '../../lib/remark-product-figures.mjs';
import { productScore } from '../../lib/score.mjs';
import { brandsIn } from '../../lib/brands.mjs';
import fs from 'node:fs';
import crypto from 'node:crypto';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const d = post.data;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const inBody: string[] = remarkPluginFrontmatter?.productsInBody ?? [];
const toc = headings.filter((h) => h.depth === 2);
const url = absUrl(`/blog/${post.id}/`);
const modified = d.updatedDate ?? d.pubDate;
// Owner research totals for the "How we picked" box and the sources list.
const ownerReads = d.products.reduce((n, p) => n + (p.owners?.read ?? 0), 0);
const ownerSources = [...new Map(d.products.flatMap((p) => p.owners?.sources ?? []).map((s) => [s.url, s])).values()];
const reviewPool = ownerSources.reduce((n, s) => n + (s.reviews ?? 0), 0);
const researchNote = [
  reviewPool > 0 ? `We studied review themes from ${reviewPool.toLocaleString('en-US')} verified-buyer and owner reviews on retailer sites.` : '',
  ownerReads > 0 ? `We read ${ownerReads} owner posts, user discussions and expert reviews across ${ownerSources.length} sources.` : '',
  `Every spec was checked against ${d.sources.length} maker and retailer pages. We did not test these products ourselves.`,
].filter(Boolean).join(' ');
const reviewed = d.reviewedDate ?? modified;
const author = getAuthor(d.author);
const authorUrl = `/authors/${author.slug}/`;
const heroPhoto = d.photos.find((p) => p.placement === 'hero');
const hero = d.heroImage ?? heroPhoto?.url;
const heroPick = d.products.find((p) => p.image?.url);
const brands = brandsIn(d.products);
// Version the header graphic by its content so browsers never show a stale copy.
const heroBaseFile = new URL(`../../../public/images/hero/${post.id}.png`, import.meta.url);
const heroBaseVer = fs.existsSync(heroBaseFile) ? crypto.createHash('md5').update(fs.readFileSync(heroBaseFile)).digest('hex').slice(0, 8) : '0';

const byId = new Map(all.map((p) => [p.id, p]));
const seen = new Set([post.id]);
const related = [
  ...d.related.map((id) => byId.get(id)),
  ...all.filter((p) => p.data.category === d.category),
  ...all,
].filter((p) => p && !seen.has(p.id) && seen.add(p.id)).slice(0, 4);
// The closest guide becomes the 'Read next' card; the rest fill 'Related guides'.
const [readNext, ...relatedRest] = related;

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: d.title,
    description: d.description,
    url,
    mainEntityOfPage: url,
    datePublished: d.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    articleSection: categoryName(d.category),
    inLanguage: 'en-US',
    isPartOf: { '@id': absUrl('/#website') },
    wordCount: post.body?.split(/\s+/).length,
    ...(d.reviewedDate ? { lastReviewed: d.reviewedDate.toISOString() } : {}),
    keywords: [d.keyword, ...d.secondaryKeywords].join(', '),
    about: d.entities.slice(0, 8).map((name) => ({ '@type': 'Thing', name })),
    image: { '@type': 'ImageObject', url: absUrl(hero ?? '/og-default.png'), width: 1200, height: 630 },
    author: authorSchema(author),
    publisher: { '@id': absUrl('/#organization') },
    ...(d.sources.length || ownerSources.length ? { citation: [...d.sources, ...ownerSources].map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })) } : {}),
    ...(ownerReads > 0 || reviewPool > 0 ? { backstory: researchNote } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absUrl('/') },
      { '@type': 'ListItem', position: 2, name: categoryName(d.category), item: absUrl(`/category/${d.category}/`) },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
// Editorial product reviews: our own Best Tripod Score for each product
// (no third-party ratings, no offers; we don't sell the products).
for (const p of d.products) {
  const score = productScore(p.scores);
  if (score == null) continue;
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    ...(p.brand ? { brand: { '@type': 'Brand', name: p.brand } } : {}),
    ...(p.image?.url ? { image: [p.image.url, ...(p.gallery ?? []).map((g) => g.url)] } : {}),
    description: p.summary,
    review: {
      '@type': 'Review',
      name: `${p.name}: ${p.badge}`,
      author: authorSchema(author),
      publisher: { '@id': absUrl('/#organization') },
      datePublished: d.pubDate.toISOString().slice(0, 10),
      reviewBody: [p.summary, p.scoreNote].filter(Boolean).join(' '),
      reviewRating: { '@type': 'Rating', ratingValue: score, bestRating: 5, worstRating: 1 },
      ...(p.pros?.length ? { positiveNotes: { '@type': 'ItemList', itemListElement: p.pros.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x })) } } : {}),
      ...(p.cons?.length ? { negativeNotes: { '@type': 'ItemList', itemListElement: p.cons.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x })) } } : {}),
      ...(p.owners ? { citation: p.owners.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })) } : {}),
    },
  });
}
if (d.faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
if (d.products.length > 1) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: d.title,
    itemListElement: d.products.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `${url}#pick-${p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`,
      ...(p.image?.url ? { image: p.image.url } : {}),
    })),
  });
}
---
<Base title={d.seoTitle ?? d.title} description={d.description} image={hero} imageAlt={d.heroAlt ?? d.title} keywords={[d.keyword, ...d.secondaryKeywords]} section={categoryName(d.category)} tags={d.tags} authorUrl={absUrl(authorUrl)} type="article" jsonLd={jsonLd} publishedTime={d.pubDate.toISOString()} modifiedTime={modified.toISOString()}>
  <div class="wrap">
    <header class="article-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/category/${d.category}/`}>{categoryName(d.category)}</a>
      </nav>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <div class="byline">
        <div class="who">
          <span class="avatar">{(author.image || author.type !== 'Person') ? <img src={author.image ?? '/favicon.svg'} alt="" width="40" height="40" /> : initials(author.name)}</span>
          <span>By <a href={authorUrl} rel="author">{author.name}</a></span>
        </div>
        <div class="facts">
          <span>Updated <time datetime={modified.toISOString()}>{formatDate(modified)}</time></span>
          {d.readingTime && <span>{d.readingTime}-minute read</span>}
        </div>
      </div>
      {heroPick ? (
        <figure class="hero-composite">
          <div class="hc-frame">
            <img class="hc-base" src={heroPhoto ? heroPhoto.url : `/images/hero/${post.id}.png?v=${heroBaseVer}`} alt={heroPhoto?.alt ?? d.heroAlt ?? d.title} width="1200" height="630" fetchpriority="high" decoding="async" />
            <a class="hc-product" href={amazonUrl({ asin: heroPick.asin, query: heroPick.query })} rel={AFFILIATE_REL} target="_blank" tabindex="-1">
              <img src={heroPick.image!.url} alt={heroPick.name} width={heroPick.image!.width ?? 500} height={heroPick.image!.height ?? 500} decoding="async" />
            </a>
          </div>
          <figcaption>{heroPick.name}. <span class="credit">Product photo: {imageCredit(heroPick).replace(/^Image: /, '')}</span>{heroPhoto && <span class="credit"> Background: <Fragment set:html={unsplashCredit(heroPhoto)} /></span>}</figcaption>
        </figure>
      ) : hero && (
        <figure class="hero-fig">
          <img class="hero-img" src={hero} alt={heroPhoto?.alt ?? d.heroAlt ?? d.title} width="1200" height="630" fetchpriority="high" decoding="async" />
          {heroPhoto && !d.heroImage && <figcaption class="credit"><Fragment set:html={unsplashCredit(heroPhoto)} /></figcaption>}
        </figure>
      )}
    </header>

    <div class="article-layout">
      <article>
        {toc.length > 1 && (
          <details class="toc-mobile">
            <summary>In this guide ({toc.length + (d.products.length > 0 ? 1 : 0) + (d.faqs.length > 0 ? 1 : 0)} sections)</summary>
            <ol>
              {d.products.length > 0 && <li><a href="#top-picks">Our top picks</a></li>}
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              {d.faqs.length > 0 && <li><a href="#faq">Questions photographers ask</a></li>}
            </ol>
          </details>
        )}
        <p class="disclosure">We earn a commission if you buy through links on this page, at no extra cost to you. It never changes what we recommend. <a href="/affiliate-disclosure/">How we make money</a>.</p>
        {ownerReads > 0 && (
          <section class="research-box" aria-labelledby="how-picked">
            <h2 id="how-picked">How we picked these</h2>
            <ul>
              {reviewPool > 0 && <li>Review themes from <b>{reviewPool.toLocaleString('en-US')}</b> verified-buyer and owner reviews on retailer sites, so every pick shows what buyers praise and complain about.</li>}
              <li><b>{ownerReads}</b> owner posts, user discussions and expert reviews read across <b>{ownerSources.length}</b> sources.</li>
              <li>Every spec checked against <b>{d.sources.length}</b> maker and retailer pages.</li>
              <li>We did not test these products ourselves, and we say so. All sources are linked at the end of this guide.</li>
            </ul>
          </section>
        )}
        <ProductPicks products={d.products} inBody={inBody} style={d.productStyle} />
        {brands.length > 0 && (
          <nav class="brand-chips" aria-label="Brands in this guide">
            <span>Brands in this guide:</span>
            {brands.map((b) => <a href={`/brand/${b.slug}/`}>{b.name}</a>)}
          </nav>
        )}
        {d.tldr.length > 0 && (
          <div class="answer">
            <h2>The short answer</h2>
            <ul>{d.tldr.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
        <div class="prose">
          <Content />
        </div>

        {d.faqs.length > 0 && (
          <section class="faq" aria-labelledby="faq">
            <h2 id="faq">Questions photographers ask</h2>
            {d.faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        <section class="trust-box" aria-labelledby="trust">
          <h2 id="trust">Why you can trust this guide</h2>
          <ul>
            <li>Products are checked against manufacturer specifications, user manuals and long-term owner reports.</li>
            <li>Each pick is scored on the Best Tripod Score: stability, portability (weight and folded length), working height, build quality and value.</li>
            <li>We never accept payment for placement. Affiliate commissions do not affect rankings.</li>
          </ul>
          <p>Last reviewed <time datetime={reviewed.toISOString()}>{formatDate(reviewed)}</time>. Read our <a href="/how-we-research/">research process</a> and <a href="/editorial-policy/">editorial policy</a>, or <a href="/contact/">report an error</a>.</p>
        </section>

        <aside class="brand-cta" aria-labelledby="brand-cta">
          <h2 id="brand-cta">Buying a tripod? Use the {SITE.name} Checklist</h2>
          <p>Every spec we check, from load capacity to folded length, in one free list that saves your progress.</p>
          <a class="btn btn-primary btn-sm" href="/tripod-buying-checklist/">Open the checklist</a>
        </aside>

        {(d.sources.length > 0 || ownerSources.length > 0) && (
          <section class="sources" aria-labelledby="sources">
            <h2 id="sources">Sources</h2>
            {d.sources.length > 0 && <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ol>}
            {ownerSources.length > 0 && (
              <>
                <h3>Reviews and discussions we read</h3>
                <ol>{ownerSources.map((s) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a>{s.reviews ? ` (${s.reviews.toLocaleString('en-US')} reviews)` : ''}</li>)}</ol>
              </>
            )}
          </section>
        )}

        <div class="share" aria-label="Share this guide">
          <span>Found this useful? Share it with a photographer friend:</span>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Facebook</a>
          <a href={`https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}`} target="_blank" rel="noopener">X</a>
          <a href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&media=${encodeURIComponent(absUrl(hero ?? '/images/og/home.png'))}&description=${encodeURIComponent(d.title)}`} target="_blank" rel="noopener">Pinterest</a>
          <a href={`mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(url)}`}>Email</a>
          <button type="button" class="copy-link" data-url={url}>Copy link</button>
        </div>

        {readNext && (
          <a class="read-next" href={`/blog/${readNext.id}/`}>
            <span class="kicker">Read next</span>
            <strong>{readNext.data.title}</strong>
            <span>{readNext.data.description}</span>
          </a>
        )}

        <div class="author-box">
          <span class="avatar">{(author.image || author.type !== 'Person') ? <img src={author.image ?? '/favicon.svg'} alt="" width="56" height="56" /> : initials(author.name)}</span>
          <div>
            <h2><a href={authorUrl} style="color:inherit">{author.name}</a></h2>
            <p class="role">{author.role}</p>
            <p>{author.bio}</p>
          </div>
        </div>
      </article>

      <aside>
        {toc.length > 1 && (
          <nav class="toc" aria-label="Table of contents">
            <h2>In this guide</h2>
            <ol>
              {d.products.length > 0 && <li><a href="#top-picks">Our top picks</a></li>}
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              {d.faqs.length > 0 && <li><a href="#faq">Questions photographers ask</a></li>}
            </ol>
          </nav>
        )}
      </aside>
    </div>

    {relatedRest.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Related guides</h2></div>
        <div class="posts">{relatedRest.map((p) => <PostItem post={p!} />)}</div>
      </section>
    )}
  </div>
</Base>

<script>
  // Copy-link share button.
  document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((b) =>
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.url!); b.textContent = 'Link copied'; } catch { b.textContent = b.dataset.url!; }
    }),
  );
  // Product galleries: clicking a thumbnail swaps the main photo.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pg-thumb');
    if (!btn) return;
    const fig = btn.closest('.pgallery');
    const img = fig?.querySelector<HTMLImageElement>('.pg-main img');
    if (!img || !btn.dataset.src) return;
    img.src = btn.dataset.src;
    fig!.querySelectorAll('.pg-thumb').forEach((b) => b.classList.toggle('is-on', b === btn));
  });
</script>
