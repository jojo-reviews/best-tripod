---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';
const used = new Set((await getPublishedPosts()).map((p) => p.data.category));
// Categories that are not in the main nav show up in the menu once they have a guide.
const extra = SITE.categories.filter((c) => ['tabletop-mini-tripods', 'tripod-accessories'].includes(c.slug) && used.has(c.slug));
const path = Astro.url.pathname;
const links = [
  { href: '/category/travel-tripods/', label: 'Travel' },
  { href: '/category/camera-tripods/', label: 'Camera' },
  { href: '/category/video-tripods/', label: 'Video' },
  { href: '/category/phone-tripods/', label: 'Phone' },
  { href: '/category/monopods/', label: 'Monopods' },
  { href: '/category/tripod-heads/', label: 'Heads' },
  { href: '/brands/', label: 'Brands' },
];
---
<header class="site-header">
  <div class="wrap">
    <Logo />
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) || (l.href === '/brands/' && path.startsWith('/brand/')) ? 'page' : undefined}>{l.label}</a>)}
      <a href="/search/" class="nav-search" aria-label="Search guides">Search</a>
    </nav>
    <details class="menu">
      <summary>Menu</summary>
      <div class="menu-panel">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        {extra.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}
        <a href="/blog/">All guides</a>
        <a href="/tripod-buying-checklist/">The buying checklist</a>
        <a href="/search/">Search</a>
        <a href="/about/">About us</a>
      </div>
    </details>
  </div>
</header>
